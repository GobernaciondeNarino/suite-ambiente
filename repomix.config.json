{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "Suite Ambiente Nariño — plugin WordPress de observación ambiental (Gobernación de Nariño). Empaquetado para análisis con IA.",
    "removeComments": false,
    "showLineNumbers": false,
    "topFilesLength": 10
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".claude/skills/**",
      "suite-ambiente-narino/assets/vendor/**",
      "suite-ambiente-narino/data/**",
      "package-lock.json",
      "graphify-out/**",
      "docs/anexo-public-apis.md"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
